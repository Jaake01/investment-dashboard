# Firebase web app config (from Firebase Console > Project settings > Your apps).
# These values are not secret by Firebase's design — the config identifies the
# project, it doesn't grant access. Real access control is Firestore Security
# Rules + Auth (see firestore.rules). Copy this file to .env.local (already
# git-ignored) and fill in your project's real values for local development.
# For the deployed build, the same values go into the repo's GitHub Actions
# "Variables" (not Secrets — see .github/workflows/deploy.yml).
#
# Cross-device sync (Google sign-in) is entirely optional — leave these unset
# and the app works exactly as before, purely local to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
